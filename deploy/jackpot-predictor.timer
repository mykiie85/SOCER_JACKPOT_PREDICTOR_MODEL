# ~/.config/systemd/user/jackpot-predictor.timer
#
# Fires at 11:00 and 20:00 EAT every day. main.py itself decides whether a
# delivery stage is due (config schedule.stages: the preview two days before
# the first kickoff at 20:00, the final on match day at 11:00 with refreshed
# prices) and exits quietly otherwise, so one timer covers Supa + Midweek and
# any schedule changes SportPesa makes.
[Unit]
Description=Jackpot Predictor — 11:00 + 20:00 EAT stage gate

[Timer]
OnCalendar=*-*-* 11:00:00 Africa/Nairobi
OnCalendar=*-*-* 20:00:00 Africa/Nairobi
Persistent=true

[Install]
WantedBy=timers.target
